PORT=4000
NODE_ENV=production
NAME=Proof Generation API

# ETHEREUM_RPC and MATIC_RPC must have the same number of entries.
# Index n in each array must be endpoints from the same provider — the retry
# logic switches providers by incrementing the index across both arrays
# simultaneously. A mismatch means retries may still hit a degraded provider
# on one side.
ETHEREUM_RPC=["https_url_for_eth_rpc1", "https_url_for_eth_rpc2"]
MATIC_RPC=["https_url_for_matic_rpc1", "https_url_for_matic_rpc2"]

# Same pairing constraint applies to SEPOLIA_RPC and AMOY_RPC.
SEPOLIA_RPC=["https_url_for_sepolia_rpc1"]
AMOY_RPC=["https_url_for_amoy_rpc1"]

SENTRY_DSN=sentry dsn

PRETTY_LOGS=true # Prettyprint logs instead of raw JSON output (for local dev)
