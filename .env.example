PORT=4000
NODE_ENV=production
NAME=Proof Generation API

# One RPC URL per chain (plain string, not a JSON array).
ETHEREUM_RPC=https_url_for_eth_rpc
MATIC_RPC=https_url_for_matic_rpc
ZKEVM_MAINNET_URL=https_url_for_zkevm_mainnet

SEPOLIA_RPC=https_url_for_sepolia_rpc
AMOY_RPC=https_url_for_amoy_rpc
ZKEVM_TESTNET_URL=https_url_for_zkevm_testnet

SENTRY_DSN=sentry dsn

PRETTY_LOGS=true # Prettyprint logs instead of raw JSON output (for local dev)
