{
  "config": {
    "default": true,
    "MD013": false,
    "MD041": false,
    "MD024": { "siblings_only": true },
    "MD060": false
  },
  // CHANGELOG.md is regenerated by `changeset version` on every release, which
  // rewrites entries in its own format; linting it fails PRs on text nobody
  // edits (the shared @polygonlabs/apps-team-lint config ignores it too).
  "ignores": ["**/node_modules/**", "**/.claude/**", "**/CHANGELOG.md"]
}
