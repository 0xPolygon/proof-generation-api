{
  "extends": ["@tsconfig/node24", "@tsconfig/node-ts"],
  "compilerOptions": {
    "noEmit": true,

    // Additional type-checking strictness beyond @tsconfig/node24 defaults
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,

    // Node 24 native TypeScript execution
    "allowImportingTsExtensions": true,

    // Additional recommended options
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",

    // Other outputs (used by tsconfig.build.json)
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  },
  "exclude": ["node_modules", "dist", "vitest.config.ts"]
}
